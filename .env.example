# Required: Gemini API key (from Google AI Studio: https://aistudio.google.com/app/apikey)
# used by Google ADK.
GEMINI_API_KEY=

# Required: URL to the payments-toolkit-mcp server's /mcp endpoint. Run
# `pnpm run start:http` in that repo first (listens on port 3000 by default).
# MCP_SERVER_URL=http://localhost:3000/mcp
MCP_SERVER_URL=

# Required: shared-secret bearer token sent to the MCP server on every
# request; must match the value configured there (its own MCP_AUTH_TOKEN).
MCP_AUTH_TOKEN=

# Required for `pnpm run start:http`: your Supabase project URL
# (Project Settings -> API), e.g. https://xxxxxxxxxxxx.supabase.co
# `/chat` and the sample routes verify the bearer token the frontend sends
# against this project's JWKS.
SUPABASE_URL=

# Optional: port for `pnpm run start:http` (default 3001). Different
# default than payments-toolkit-mcp's own start:http (3000) so both can
# run at once without a collision.
# PORT=3001
