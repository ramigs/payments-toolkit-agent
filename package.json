{
  "name": "payments-toolkit-agent",
  "version": "0.1.0",
  "description": "Agent backend, built with Google ADK, exposing payments-toolkit-mcp as a conversational interface.",
  "type": "module",
  "engines": {
    "node": ">=20.3.0"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:http": "tsx src/http.ts",
    "build": "tsc",
    "eval": "tsx eval/run-eval.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "scripts/bump-mcp-commit.sh && railway up",
    "stop": "railway down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ag-ui/core": "^0.0.58",
    "@google/adk": "^2.0.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.2.3",
    "hono": "^4.13.4",
    "jose": "^6.2.12",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
